# 策略参数（不含任何密钥，可随意修改）。命令行参数可临时覆盖，例如 --usdg 50 --fee 3
# Solana（--chain solana）上同一套参数：USDG_AMOUNT 是 SOL（或 USDC，见 .env 的 SOL_QUOTE）的数量；POOL_FEE 只能是链上的固定档（DLMM 的基础费 / Raydium 的费率档，
# 网页进场页的费率提示里有列表）；TICK_SPACING 是 DLMM 的 binStep / Raydium 的 tickSpacing；LP_SHAPE 在 DLMM 上是它原生的 Spot / Curve / BidAsk 策略（LP_LAYERS 不用）

POOL_FEE=4          # 池子手续费，百分比：5 = 5%，3 = 3%，0.3 = 0.3%。PancakeSwap v3 只有 0.01 / 0.05 / 0.25 / 1 四档（不在其中时 auto 模式只找已有池）
POOL_SELECT=auto      # auto: 配置的池不存在时，自动复用该币已有的 USDG 池（同费率优先，否则成交最活跃的）；exact: 只用自己配置的费率/间距
TICK_SPACING=         # 留空 = fee/50（5%→1000、3%→600、1%→200），只在建新池时生效；复用已有池时以链上为准
USDG_AMOUNT=500       # LP 总预算（计价币：Robinhood 是 USDG，BSC 是 USDT）：自动算出该换多少代币，剩余 USDG 直接进 LP
PRICE_RANGE=          # 绝对价格区间（USDG/代币）"最低价,最高价"，如 0.006,0.01；填了就优先于下面的 RANGE。整体在现价下方 = 纯 USDG 挂单等跌，整体在上方 = 全换成代币挂单等涨
RANGE=-50%,150%   # 区间（相对现价）：-50%,+100% 双边；只填 -50% = 只做下方(全 USDG 挂买单)；只填 +100% = 只做上方(全代币挂卖单)；边界落在 tick 格点上
LP_SHAPE=spot         # 流动性形状：spot = 一个仓位、区间内均匀；curve = 同心嵌套、越靠现价越厚（震荡吃费）；bidask = 两侧分段、越远越厚（跌买涨卖，含现价的一格空着）
LP_LAYERS=3           # curve 的层数 / bidask 每侧的段数（2~8），每层一个仓位，同一笔交易创建；换币只做一次
SWAP_SLIPPAGE=5       # 换币滑点 %
LP_SLIPPAGE=5         # 组 LP 时 amountMax 余量 %
MAX_DEVIATION=10      # 池价与市场价最大偏离 %：超过则先在池内交易把价格拉回市场价，拉不回/超预算则放弃
EXIT_SWAP_VIA=best       # 撤退时卖币走哪家：best = Uniswap、OKX 和仓位所在的池都报价取高者；okx；uniswap；pool（只在池里直换）。Solana 上 best = Jupiter 和池内取高者；jupiter；pool
WATCH_INTERVAL=5     # 监控：每隔几秒检查一次池价
WATCH_CONFIRM=2       # 监控：连续几次检查都跳出区间才触发撤退（防单次插针）
WATCH_UPPER_GRACE=600 # 监控：价格涨破上沿后再等几秒没回来才撤退（此时仓位已全是 USDG，等着没风险）；0 = 不等，跌破下沿不受此影响
WATCH_STOP_LOSS=0     # 监控：止损 %。填了就只按止损撤退、不再看跳出区间：整组（Curve / Bid-Ask 的几段合起来）现值 + 手续费比进场本金少这么多就撤退并卖币；0 = 不开
