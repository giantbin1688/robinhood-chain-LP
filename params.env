# 策略参数（不含任何密钥，可随意修改）。命令行参数可临时覆盖，例如 --usdg 50 --fee 3

POOL_FEE=1.9999            # 池子手续费，百分比：5 = 5%，3 = 3%，0.3 = 0.3%
POOL_SELECT=auto      # auto: 配置的池不存在时，自动复用该币已有的 USDG 池（同费率优先，否则成交最活跃的）；exact: 只用自己配置的费率/间距
TICK_SPACING=         # 留空 = fee/50（5%→1000、3%→600、1%→200），只在建新池时生效；复用已有池时以链上为准
USDG_AMOUNT=1000       # LP 总预算（USDG）：自动算出该换多少代币，剩余 USDG 直接进 LP
RANGE=-60%,+15%       # 区间（相对现价）：-50%,+100% 双边；只填 -50% = 只做下方(全 USDG 挂买单)；只填 +100% = 只做上方(全代币挂卖单)；边界落在 tick 格点上
SWAP_SLIPPAGE=5       # 换币滑点 %
LP_SLIPPAGE=5         # 组 LP 时 amountMax 余量 %
MAX_DEVIATION=10      # 池价与市场价最大偏离 %：超过则先在池内交易把价格拉回市场价，拉不回/超预算则放弃
EXIT_SWAP_VIA=best       # 撤退时卖币走哪家：best = Uniswap 和 OKX 都报价取高者（未配置 OKX 时只有 Uniswap）；okx；uniswap
WATCH_INTERVAL=5     # 监控：每隔几秒检查一次池价
WATCH_CONFIRM=2       # 监控：连续几次检查都跳出区间才触发撤退（防单次插针）
