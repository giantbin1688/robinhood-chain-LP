# 复制为 .env 后填写。策略参数（费率/预算/区间/滑点/偏离阈值）在 params.env，不放这里

# 付款钱包私钥（0x 开头 64 位十六进制），两条链共用一个地址。Robinhood 上要 USDG + 少量 ETH 付 gas；BSC 上要 USDT + 少量 BNB
PRIVATE_KEY=

# Uniswap Trading API key（换币路由服务的密钥，和钱包无关）：https://developers.uniswap.org/dashboard
UNISWAP_API_KEY=

# 可选：OKX DEX 聚合器（换币时和 Uniswap 比价，取高者）。在 https://web3.okx.com/onchainos 申请 API key
# BSC 上基本必配：Uniswap API 只看 Uniswap 自家的池，PancakeSwap 的深度只有 OKX 能路由到
#OKX_API_KEY=
#OKX_SECRET_KEY=
#OKX_API_PASSPHRASE=

# 可选：信号页（盯 FOMO 交易者）的提醒和查询。这几项也可以在网页的设置页填（存 settings.json，设置页优先）；fomo 账号的 Privy token 只能在设置页填
#TG_BOT_TOKEN=          # Telegram bot token（@BotFather 申请），配了买入 / 卖出 / 安全检查不通过会推消息
#TG_CHAT_ID=            # 接收消息的 chat id（@userinfobot 查）
#FOMOSCAN_KEY=          # https://www.fomoscan.sh 的 key（付费第三方）：添加交易者时只填 handle 自动查钱包；不配就手填地址

# 可选
#RPC_URL=https://rpc.mainnet.chain.robinhood.com   # Robinhood 节点，建议换成自己的 Alchemy 节点（快 5 倍）：https://robinhood-mainnet.g.alchemy.com/v2/<key>
#BSC_RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/<key>   # BSC 节点（Alchemy 的 app 里要勾上 BNB Smart Chain）；不填走公共节点 https://bsc-rpc.publicnode.com，没有资金流水/盈亏
#CHAIN=robinhood        # 命令行默认链：robinhood | bsc（也可每次 --chain 指定；网页界面在页面顶部切换）
#PROTOCOL=v4            # 默认协议：Robinhood 只有 v4；BSC 可选 infinity（PancakeSwap Infinity CLAMM）| v3（PancakeSwap v3）| v4（Uniswap v4）
#UNISWAP_API_URL=https://trade-api.gateway.uniswap.org/v1

# 本机直连不了 trade-api.gateway.uniswap.org 或 alchemy.com 时，填本地代理（Clash/v2ray 等）
#HTTPS_PROXY=http://127.0.0.1:7897
#NO_PROXY=localhost,127.0.0.1
