# 复制为 .env 后填写。策略参数（费率/预算/区间/滑点/偏离阈值）在 params.env，不放这里

# 付款钱包私钥（0x 开头 64 位十六进制），Robinhood / BSC 两条链共用一个地址。Robinhood 上要 USDG + 少量 ETH 付 gas；BSC 上要 USDT + 少量 BNB
PRIVATE_KEY=

# Solana 钱包私钥：base58（Phantom 导出的那串）或 JSON 字节数组（solana-keygen 的 id.json 内容）。钱包里要有 SOL（预算 + 仓位租金 + 手续费；USDC 计价时还要 USDC）
SOL_PRIVATE_KEY=

# Uniswap Trading API key（换币路由服务的密钥，和钱包无关）：https://developers.uniswap.org/dashboard
UNISWAP_API_KEY=

# 可选：OKX DEX 聚合器（换币时和 Uniswap 比价，取高者）。在 https://web3.okx.com/onchainos 申请 API key
# BSC 上基本必配：Uniswap API 只看 Uniswap 自家的池，PancakeSwap 的深度只有 OKX 能路由到
#OKX_API_KEY=
#OKX_SECRET_KEY=
#OKX_API_PASSPHRASE=

# 可选：信号页（盯 FOMO 交易者）的提醒和查询。这几项、下面的 RPC_URL / BSC_RPC_URL / SOL_RPC_URL / JUPITER_API_KEY / SOL_PRIORITY_FEE / SOL_HISTORY_TXS / UNISWAP_API_URL
# 也都可以在网页的设置页填（存 settings.json，设置页优先于这里）
#TG_BOT_TOKEN=          # Telegram bot token（@BotFather 申请），配了买入 / 卖出 / 安全检查不通过会推消息
#TG_CHAT_ID=            # 接收消息的 chat id（@userinfobot 查）

# 可选
#RPC_URL=https://rpc.mainnet.chain.robinhood.com   # Robinhood 节点，建议换成自己的 Alchemy 节点（快 5 倍）：https://robinhood-mainnet.g.alchemy.com/v2/<key>
#BSC_RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/<key>   # BSC 节点（Alchemy 的 app 里要勾上 BNB Smart Chain）；不填走公共节点 https://bsc-rpc.publicnode.com，没有资金流水/盈亏
#SOL_RPC_URL=https://solana-mainnet.g.alchemy.com/v2/<key>  # Solana 节点；不填走公共节点 https://api.mainnet-beta.solana.com（慢、限流）。Alchemy 免费档不给 getProgramAccounts，这一种请求自动走公共节点
#ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<key>   # Ethereum 主网；也可在网页设置中保存
#CHAIN=robinhood        # 命令行默认链：robinhood | bsc | ethereum | solana（也可每次 --chain 指定；网页界面在页面顶部切换）
#PROTOCOL=v4            # 默认协议：Robinhood 只有 v4；BSC 可选 infinity（PancakeSwap Infinity CLAMM）| v3（PancakeSwap v3）| v4（Uniswap v4）；Solana 可选 dlmm（Meteora DLMM）| clmm（Raydium CLMM）
#SOL_QUOTE=SOL          # Solana 进场的计价币：SOL（默认，绝大多数池）| USDC；仓位页两种都列
#JUPITER_API_KEY=       # 可选：Solana 换币走 Jupiter，默认用免 key 的 lite-api.jup.ag（每分钟 60 次够用）；配了 key 走 api.jup.ag
#SOL_PRIORITY_FEE=100000  # Solana 优先费（每计算单元的微 lamport，默认 100000 ≈ 一笔 0.00003 SOL）；拥堵时调大
#SOL_HISTORY_TXS=800    # 盈亏日历第一次要扫钱包最近多少笔交易找已平仓仓位（Alchemy 免费档约 100 笔 / 4 秒）
#UNISWAP_API_URL=https://trade-api.gateway.uniswap.org/v1

# 本机直连不了 trade-api.gateway.uniswap.org 或 alchemy.com 时，填本地代理（Clash/v2ray 等）
#HTTPS_PROXY=http://127.0.0.1:7897
#NO_PROXY=localhost,127.0.0.1
