# 复制为 .env 后填写。策略参数（费率/预算/区间/滑点/偏离阈值）在 params.env，不放这里

# 付款钱包私钥（0x 开头 64 位十六进制）。需要 USDG_AMOUNT 的 USDG + 少量 ETH 付 gas
PRIVATE_KEY=

# Uniswap Trading API key（换币路由服务的密钥，和钱包无关）：https://developers.uniswap.org/dashboard
UNISWAP_API_KEY=

# 可选：OKX DEX 聚合器（撤退卖币时和 Uniswap 比价，取高者）。在 https://web3.okx.com/onchainos 申请 API key
#OKX_API_KEY=
#OKX_SECRET_KEY=
#OKX_API_PASSPHRASE=

# 可选
#RPC_URL=https://rpc.mainnet.chain.robinhood.com   # 建议换成自己的 Alchemy 节点（快 5 倍）：https://robinhood-mainnet.g.alchemy.com/v2/<key>
#UNISWAP_API_URL=https://trade-api.gateway.uniswap.org/v1

# 本机直连不了 trade-api.gateway.uniswap.org 时，填本地代理（Clash/v2ray 等）
#HTTPS_PROXY=http://127.0.0.1:7897
#NO_PROXY=localhost,127.0.0.1
