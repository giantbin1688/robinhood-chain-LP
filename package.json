{
  "name": "rh-uni",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Robinhood Chain: USDG -> token swap, create/reuse a Uniswap v4 pool, LP around spot, in one command",
  "scripts": {
    "launch": "node --env-file=.env --env-file=params.env --import tsx src/cli.ts",
    "exit": "node --env-file=.env --env-file=params.env --import tsx src/exit.ts",
    "selfcheck": "node --import tsx src/selfcheck.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "undici": "^8.10.2",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
