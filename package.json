{
  "name": "rh-uni",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One-command concentrated LP on Robinhood Chain / BNB Chain / Solana: swap, create or reuse a pool, LP around spot, monitor, exit",
  "scripts": {
    "launch": "node --env-file=.env --env-file=params.env --import tsx src/run.ts launch",
    "exit": "node --env-file=.env --env-file=params.env --import tsx src/run.ts exit",
    "watch": "node --env-file=.env --env-file=params.env --import tsx src/run.ts watch",
    "ui": "node --env-file=.env --env-file=params.env --import tsx src/ui/server.ts",
    "selfcheck": "node --import tsx src/selfcheck.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@meteora-ag/dlmm": "^1.9.14",
    "@raydium-io/raydium-sdk-v2": "^0.2.64-alpha",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "undici": "^8.10.2",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
